# PDFs are source assets stored outside Git
/pdf/
/data/pdfs/
*.pdf

# Benchmark datasets and generated QA artifacts stay in external storage.
# Keep experiment README files so the repository still documents the data
# lineage and current release locations without mirroring hundreds of MB.
/data/qa/**
!/data/qa/**/
!/data/qa/**/README.md
# The canonical 2,200-question release is small enough to publish and is
# required for the repository to be usable without external data storage.
!/data/qa/7.final_2200/
!/data/qa/7.final_2200/*.json
!/data/qa/7.final_2200/*.xlsx
/data/final_2200/
/data/eval_outputs
/data/results/
/data/web/**
!/data/web/
!/data/web/README.md
# Historical archives remain on the data volume; publish only their indexes.
/data/archive/**
!/data/archive/
!/data/archive/**/
!/data/archive/**/README.md
!/data/archive/**/*.csv

